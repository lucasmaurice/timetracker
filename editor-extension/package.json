{
  "name": "timetracker-context",
  "displayName": "TimeTracker Context",
  "description": "Feeds rich editor context (repo, branch, file, symbol, terminal commands, task) to the local TimeTracker app for better JIRA-ticket inference. 100% local — writes a heartbeat file, makes no network calls.",
  "version": "0.2.0",
  "publisher": "JusteReseau",
  "engines": {
    "vscode": "^1.84.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "timetracker.status",
        "title": "TimeTracker: Show context status"
      }
    ]
  },
  "scripts": {
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "package": "npx --yes @vscode/vsce package --skip-license -o timetracker-context.vsix",
    "vscode:prepublish": "npm run compile"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/vscode": "^1.84.0",
    "typescript": "^5.4.0"
  }
}